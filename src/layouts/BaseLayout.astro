---
const { title = 'NEXORA — Anime Encyclopedia', description = 'Ensiklopedia anime, karakter, dunia, kemampuan, dan lore.' } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d16" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
