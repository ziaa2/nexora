---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
export function getStaticPaths() {
  return ['universe', 'lore', 'abilities', 'locations', 'favorites'].map((slug) => ({
    params: { slug }
  }));
}
const { slug } = Astro.params;
const labels = {
  'universe': 'Universe Explorer', 'lore': 'Lore & Stories',
  'abilities': 'Abilities Database', 'locations': 'Locations Database',
  'favorites': 'Favorit'
};
const title = labels[slug] || 'NEXORA';
---
<BaseLayout title={`${title} — NEXORA`}>
  <Header />
  <main class="page-shell"><span class="eyebrow">NEXORA DATABASE</span><h1>{title}.</h1>
  <p class="muted">Bagian ini sedang disiapkan dan akan terhubung ke database NEXORA.</p>
  <div class="empty-state"><span>✧</span><h2>Coming soon</h2><p>Modul ini akan diaktifkan pada tahap implementasi berikutnya.</p></div></main>
  <BottomNav />
</BaseLayout>
