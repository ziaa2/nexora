---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import BottomNav from '../../components/BottomNav.astro';

// Base path Astro ("/nexora"), tanpa trailing slash.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---
<BaseLayout title="Favorit — NEXORA" description="Daftar anime, karakter, dan artikel favoritmu.">
  <Header />
  <main class="page-shell nx-shell">
    <span class="eyebrow">KOLEKSI SAYA</span><h1>Favorit <em>Saya.</em></h1>
    <p class="muted">Daftar favorit disimpan di browser ini dan tidak memerlukan akun.</p>

    <div id="nx-root" data-base={base}>
      <div class="nx-meta"><span id="nx-count" aria-live="polite"></span><button type="button" id="nx-clear" class="nx-link" hidden>Hapus semua</button></div>
      <div id="nx-grid" class="nx-grid"></div>
      <div id="nx-empty" class="empty-state" hidden>
        <span>♡</span><h2>Belum ada favorit</h2>
        <p>Tekan tombol “Simpan ke favorit” di halaman anime, karakter, universe, atau lore untuk menyimpannya di sini.</p>
        <a class="button primary nx-btn" id="nx-go" href={`${base}/anime/`}>Jelajahi anime</a>
      </div>
    </div>
  </main>
  <BottomNav />

  <script>
    import { esc, has, safeUrl, TYPE_LABEL, ENTITY, makeUrls, getFavs, removeFav, clearFavs } from '../../lib/nexora.js';

    const root = document.querySelector('#nx-root');
    const urls = makeUrls(root.dataset.base);
    const $ = (s) => root.querySelector(s);
    const els = { grid: $('#nx-grid'), count: $('#nx-count'), clear: $('#nx-clear'), empty: $('#nx-empty') };
    const glyph = (type) => (ENTITY[type]?.icon) || (type === 'character' ? '♙' : type === 'article' ? '▤' : 'N');

    function render() {
      const list = getFavs();
      els.clear.hidden = !list.length;
      els.empty.hidden = !!list.length;
      els.grid.hidden = !list.length;
      els.count.textContent = list.length ? `${list.length} favorit` : '';
      els.grid.innerHTML = list.map((f) => {
        const img = safeUrl(f.image);
        return `<div class="nx-card">
          <a href="${esc(urls.byType(f.type, f.slug))}" aria-label="${esc(f.title)}" style="display:block">
            <div class="nx-poster">${img ? `<img src="${esc(img)}" alt="" loading="lazy" decoding="async" />` : `<span class="nx-ph" aria-hidden="true">${glyph(f.type)}</span>`}<span class="nx-badge">${esc(TYPE_LABEL[f.type] || f.type)}</span></div>
            <div class="nx-info"><h3>${esc(f.title || f.slug)}</h3>${has(f.sub) ? `<p>${esc(f.sub)}</p>` : ''}</div>
          </a>
          <button type="button" class="nx-x" data-type="${esc(f.type)}" data-slug="${esc(f.slug)}" aria-label="Hapus ${esc(f.title)} dari favorit">✕</button>
        </div>`;
      }).join('');
    }

    els.grid.addEventListener('click', (e) => {
      const btn = e.target.closest?.('.nx-x');
      if (!btn) return;
      removeFav(btn.dataset.type, btn.dataset.slug);
      render();
    });
    els.grid.addEventListener('error', (e) => {
      if (e.target instanceof HTMLImageElement) { const ph = document.createElement('span'); ph.className = 'nx-ph'; ph.textContent = 'N'; e.target.replaceWith(ph); }
    }, true);
    els.clear.addEventListener('click', () => { if (confirm('Hapus semua favorit?')) { clearFavs(); render(); } });
    render();
  </script>

  <style is:global>
    .nx-shell{padding-bottom:110px}
    .nx-shell [hidden]{display:none!important}
    .nx-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .nx-back{display:inline-block;font-size:12px;color:var(--muted);margin-bottom:26px;transition:color .2s}
    .nx-back:hover{color:var(--purple)}
    .nx-toolbar{display:grid;grid-template-columns:1fr;gap:10px;margin-top:30px;padding:10px;background:#151827;border:1px solid var(--line);border-radius:14px}
    .nx-field{display:flex;align-items:center;gap:10px;min-width:0;background:#0c0f1b;border:1px solid #30344a;border-radius:10px;padding:0 12px;transition:border-color .2s}
    .nx-field:focus-within{border-color:var(--purple)}
    .nx-icon{font-size:22px;color:var(--purple);line-height:1}
    .nx-field input{width:100%;min-width:0;height:44px;background:transparent;border:0;outline:0;color:var(--white);font-size:13px}
    .nx-field input::placeholder{color:#777b90}
    .nx-field input::-webkit-search-cancel-button{filter:invert(.7)}
    .nx-field input:disabled{opacity:.5;cursor:wait}
    .nx-tabs{display:flex;gap:8px;overflow-x:auto;margin-top:30px;padding-bottom:4px;scrollbar-width:none}
    .nx-tabs::-webkit-scrollbar{display:none}
    .nx-tab{flex:none;padding:10px 16px;border-radius:999px;border:1px solid var(--line);background:#151827;color:#c9c8d8;font:600 13px 'Space Grotesk';cursor:pointer;transition:all .2s}
    .nx-tab:hover{border-color:#8e78e7}
    .nx-tab[aria-selected="true"]{background:#8b73ed2e;border-color:#8b73ed;color:#fff}
    .nx-meta{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:22px 2px 16px;min-height:20px;font-size:12px;color:var(--muted)}
    .nx-link{background:none;border:0;padding:0;color:var(--purple);font-size:12px;font-weight:600;cursor:pointer}
    .nx-link:hover{text-decoration:underline}
    .nx-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:18px}
    .nx-card{position:relative;display:block;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:linear-gradient(160deg,#1a1e30,#131624);transition:transform .25s,border-color .25s,box-shadow .25s}
    a.nx-card:hover,a.nx-card:focus-visible{transform:translateY(-4px);border-color:#8e78e7;box-shadow:0 14px 40px #6c55d033;outline:0}
    .nx-poster{position:relative;aspect-ratio:3/4;background:#0f1220;overflow:hidden;display:grid;place-items:center}
    .nx-poster.nx-wide{aspect-ratio:16/10}
    .nx-poster img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s}
    a.nx-card:hover .nx-poster img{transform:scale(1.05)}
    .nx-poster:after{content:"";position:absolute;inset:auto 0 0 0;height:40%;background:linear-gradient(transparent,#0b0d16d9);pointer-events:none}
    .nx-ph{font:700 52px 'Space Grotesk';color:#6f5fc0;opacity:.7}
    .nx-badge{position:absolute;z-index:1;top:10px;left:10px;padding:4px 8px;border-radius:7px;font:700 10px 'Space Grotesk';letter-spacing:.5px;color:#cfc4ff;background:#0b0d16d9;border:1px solid #ffffff14}
    .nx-info{padding:12px 13px 14px}
    .nx-info h3{margin:0;font:600 14px/1.35 'Space Grotesk';display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .nx-info p{margin:7px 0 0;font-size:11px;line-height:1.5;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .nx-x{position:absolute;z-index:2;top:8px;right:8px;width:32px;height:32px;border-radius:50%;border:1px solid #ffffff22;background:#0b0d16e6;color:#ff9aab;font-size:14px;cursor:pointer}
    .nx-x:hover{background:#2a1520}
    .nx-skel .nx-poster,.nx-skel.nx-photo{background:linear-gradient(100deg,#141829 30%,#1e2338 50%,#141829 70%);background-size:200% 100%;animation:nx-shimmer 1.3s infinite linear}
    .nx-skel .nx-info i{display:block;height:11px;border-radius:6px;background:#1c2033;margin-bottom:8px}
    .nx-skel .nx-info i:last-child{width:55%;margin:0}
    @keyframes nx-shimmer{to{background-position:-200% 0}}
    .nx-btn{margin-top:18px}
    #nx-error>span{color:#ff8fa3;font:700 34px 'Space Grotesk'}
    .nx-hero{position:relative;display:grid;grid-template-columns:260px 1fr;gap:34px;align-items:start}
    .nx-photo{position:relative;aspect-ratio:3/4;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#0f1220;display:grid;place-items:center;box-shadow:0 20px 60px #0006}
    .nx-photo.nx-sq{aspect-ratio:1/1}
    .nx-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .nx-main{min-width:0}
    .nx-title{font:600 clamp(30px,4.5vw,50px)/1.1 'Space Grotesk';letter-spacing:-1.5px;margin:16px 0 8px;overflow-wrap:anywhere}
    .nx-sub{margin:0 0 16px;color:#b4b4c4;font-size:14px;line-height:1.6}
    .nx-badges{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:16px}
    .nx-pill{padding:6px 11px;border-radius:8px;font:700 11px 'Space Grotesk';letter-spacing:.5px;background:#8b73ed2e;color:#d6ccff;border:1px solid #8b73ed55}
    .nx-pill.soft{background:#ffffff08;color:#c9c8d8;border-color:var(--line)}
    .nx-fav{margin-top:4px}
    .nx-fav.is-on{border-color:#8e78e7;background:#8b73ed2e;color:#fff}
    .nx-section{margin-top:44px}
    .nx-section h2{font:600 22px 'Space Grotesk';margin:0 0 14px}
    .nx-subh{font:600 12px 'Space Grotesk';letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin:18px 0 10px}
    .nx-text{margin:0;line-height:1.85;font-size:14px;color:#c4c3d3;white-space:pre-line;max-width:78ch}
    .nx-article{max-width:78ch;color:#c4c3d3;font-size:15px;line-height:1.9}
    .nx-article p{margin:0 0 18px}
    .nx-article h2,.nx-article h3{font-family:'Space Grotesk';color:var(--white);margin:30px 0 12px}
    .nx-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px}
    .nx-chip{padding:7px 13px;border-radius:999px;font-size:12px;color:#d8d4ed;background:#191d2d;border:1px solid var(--line);transition:border-color .2s}
    a.nx-chip:hover{border-color:#8e78e7;color:#fff}
    .nx-facts{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin:0}
    .nx-facts>div{padding:14px 16px;border:1px solid var(--line);border-radius:12px;background:linear-gradient(145deg,#1a1e30,#131624)}
    .nx-facts dt{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
    .nx-facts dd{margin:0;font:600 14px 'Space Grotesk';overflow-wrap:anywhere}
    .nx-minis{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px}
    .nx-mini{display:block;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#151827;transition:border-color .2s,transform .2s}
    .nx-mini:hover{border-color:#8e78e7;transform:translateY(-3px)}
    .nx-mini .nx-poster{aspect-ratio:3/4}
    .nx-mini b{display:block;padding:9px 10px 2px;font:600 12px/1.3 'Space Grotesk';display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .nx-mini small{display:block;padding:0 10px 10px;font-size:10px;color:var(--muted)}
    .nx-rel{list-style:none;margin:0;padding:0;display:grid;gap:8px}
    .nx-rel li{display:flex;justify-content:space-between;gap:12px;padding:11px 14px;border:1px solid var(--line);border-radius:10px;background:#151827;font-size:13px}
    .nx-rel span{color:var(--muted);font-size:12px}
    .nx-rel a:hover{color:var(--purple)}
    .nx-sk{display:block;height:14px;border-radius:7px;background:#1c2033;margin-bottom:14px;width:100%}
    .nx-sk-lg{height:38px;width:70%;margin-top:30px}.nx-sk-sm{width:35%}.nx-sk-md{width:60%}
    .nx-group{margin-top:34px}
    .nx-group h2{display:flex;align-items:center;justify-content:space-between;font:600 18px 'Space Grotesk';margin:0 0 12px}
    .nx-group h2 small{font:400 12px 'Inter',sans-serif;color:var(--muted)}
    .nx-rows{display:grid;gap:8px}
    .nx-row{display:flex;align-items:center;gap:14px;padding:10px;border:1px solid var(--line);border-radius:12px;background:#151827;transition:border-color .2s,transform .2s}
    .nx-row:hover{border-color:#8e78e7;transform:translateX(3px)}
    .nx-thumb{position:relative;flex:none;width:48px;height:64px;border-radius:8px;overflow:hidden;background:#0f1220;display:grid;place-items:center;color:#6f5fc0;font-weight:700}
    .nx-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .nx-row b{display:block;font:600 14px/1.3 'Space Grotesk'}
    .nx-row small{display:block;margin-top:3px;font-size:11px;color:var(--muted)}
    @media(prefers-reduced-motion:reduce){.nx-skel .nx-poster,.nx-skel.nx-photo{animation:none}.nx-card,.nx-poster img,.nx-mini,.nx-row{transition:none}}
    @media(max-width:760px){
      .nx-shell{padding-bottom:120px}
      .nx-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
      .nx-info{padding:10px 11px 12px}.nx-info h3{font-size:13px}
      .nx-hero{grid-template-columns:1fr;gap:22px}
      .nx-photo{width:min(62%,230px);margin:0 auto}
      .nx-title{font-size:30px;letter-spacing:-1px}
      .nx-section{margin-top:34px}
      .nx-facts{grid-template-columns:repeat(2,minmax(0,1fr))}
      .nx-minis{grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    }
  </style>
</BaseLayout>
