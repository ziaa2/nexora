---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
// Halaman lore, favorites, dan universe kini punya file sendiri.
// Abilities dan Locations ditampilkan di Universe Explorer, jadi alamat lamanya diarahkan ke sana.
export function getStaticPaths() {
  return ['abilities', 'locations'].map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const labels = { abilities: 'Kemampuan', locations: 'Lokasi' };
const title = labels[slug] || 'NEXORA';
const target = `${base}/universe/?type=${slug}`;
---
<BaseLayout title={`${title} — NEXORA`}>
  <Header />
  <main class="page-shell"><span class="eyebrow">NEXORA DATABASE</span><h1>{title}.</h1>
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <p class="muted">Mengalihkan ke Universe Explorer…</p>
  <a class="button primary" href={target}>Buka {title}</a></main>
  <BottomNav />
  <script is:inline define:vars={{ target }}>location.replace(target);</script>
</BaseLayout>
